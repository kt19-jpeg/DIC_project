    "from pyspark.ml.evaluation import RegressionEvaluator\n",
    "\n",
    "# ── Results \n",
    "# ridge_model is a PipelineModel (picked as best_model from the manual sweep)\n",
    "ridge_test_preds = ridge_model.transform(ridge_test)\n",
    "\n",
    "ridge_rmse = ridge_evaluator.evaluate(ridge_test_preds)\n",
    "\n",
    "ridge_mae = RegressionEvaluator(\n",
    "    labelCol=RIDGE_TARGET, predictionCol=\"predicted_deaths\", metricName=\"mae\"\n",
    ").evaluate(ridge_test_preds)\n",
    "\n",
    "ridge_r2 = RegressionEvaluator(\n",
    "    labelCol=RIDGE_TARGET, predictionCol=\"predicted_deaths\", metricName=\"r2\"\n",
    ").evaluate(ridge_test_preds)\n",
    "\n",
    "# Last stage is the fitted LinearRegressionModel\n",
    "ridge_stage = ridge_model.stages[-1]\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"RIDGE REGRESSION RESULTS\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"Best regParam      : {ridge_stage.getRegParam()}\")\n",
    "print(\"elasticNetParam    : 0.0 (pure Ridge / L2)\")\n",
    "print(f\"RMSE               : {ridge_rmse:.2f}\")\n",
    "print(f\"MAE                : {ridge_mae:.2f}\")\n",
    "print(f\"R²                 : {ridge_r2:.4f}\")\n"
   ]
