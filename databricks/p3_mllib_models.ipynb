   "source": [
    "# rf_model is a PipelineModel (NOT a CrossValidatorModel)\n",
    "rf_test_preds = rf_model.transform(test_df)\n",
    "\n",
    "auc_roc = rf_evaluator.evaluate(rf_test_preds)\n",
    "\n",
    "total = rf_test_preds.count()\n",
    "correct = rf_test_preds.filter(F.col(\"prediction\") == F.col(\"label\")).count()\n",
    "accuracy = correct / total if total else 0.0\n",
    "\n",
    "# Last stage is the fitted RandomForestClassificationModel\n",
    "rf_stage = rf_model.stages[-1]\n",
    "\n",
    "\n",
    "# -----------------------------\n",
    "# Regression-style metrics on P(class=1)\n",
    "# -----------------------------\n",
    "rf_test_preds_prob = rf_test_preds.withColumn(\n",
    "    \"p1\", vector_to_array(F.col(\"probability\"))[1].cast(\"double\")\n",
    ")\n",
    "\n",
    "rmse = RegressionEvaluator(labelCol=\"label\", predictionCol=\"p1\", metricName=\"rmse\") \\\n",
    "    .evaluate(rf_test_preds_prob)\n",
    "\n",
    "r2 = RegressionEvaluator(labelCol=\"label\", predictionCol=\"p1\", metricName=\"r2\") \\\n",
    "    .evaluate(rf_test_preds_prob)\n",
    "\n",
    "\n",
    "print(f\"numTrees      : {rf_stage.getNumTrees}\")        # property (int)\n",
    "print(f\"maxDepth      : {rf_stage.getMaxDepth()}\")      # method\n",
    "print(f\"AUC-ROC       : {auc_roc:.4f}\")\n",
    "print(f\"Accuracy      : {accuracy:.4f}\")\n",
    "print(f\"RMSE      : {rmse:.4f}\")\n",
    "print(f\"R²        : {r2:.4f}\")\n",
    "\n",
    "print(\"\\nConfusion Matrix:\")\n",
    "rf_test_preds.groupBy(\"label\", \"prediction\").count().orderBy(\"label\", \"prediction\").show()\n",
    "\n",
    "print(\"\\nTop feature importances (numeric features):\")\n",
    "importances = rf_stage.featureImportances.toArray()\n",
    "\n",
    "for name, imp in zip(NUM_FEATURES, importances[:len(NUM_FEATURES)]):\n",
    "    print(f\"  {name:30s}: {imp:.4f}\")"
   ]
