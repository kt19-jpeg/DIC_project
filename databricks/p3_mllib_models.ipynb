   "source": [
    "# In Spark MLlib, Ridge = LinearRegression with elasticNetParam=0.0\n",
    "# The regParam controls the strength of L2 penalty — tuned via CrossValidator\n",
    "\n",
    "RIDGE_FEATURES = [\n",
    "    # CDC features\n",
    "    \"year\",\n",
    "    \"avg_monthly_deaths\",\n",
    "    \"peak_month_deaths\",\n",
    "    \"stddev_monthly_deaths\",\n",
    "    \"months_reported\",\n",
    "    \"yoy_pct_change\",\n",
    "    # KFF OUD features (multi-source)\n",
    "    \"adult_oud_pct\",\n",
    "    \"adolescent_oud_pct\",\n",
    "    \"combined_oud_pct\"\n",
    "]\n",
    "RIDGE_TARGET = \"annual_deaths\"\n",
    "\n",
    "ridge_data = (\n",
    "    gold_kff\n",
    "    .filter(F.col(\"year\").between(2016, 2023))\n",
    "    .dropna(subset=RIDGE_FEATURES + [RIDGE_TARGET])\n",
    "    .withColumn(RIDGE_TARGET, F.col(RIDGE_TARGET).cast(DoubleType()))\n",
    ")\n",
    "\n",
    "print(f\"Ridge input rows: {ridge_data.count():,}\")\n",
    "ridge_data.select(RIDGE_FEATURES + [RIDGE_TARGET]).describe().show()"
   ]
  },
