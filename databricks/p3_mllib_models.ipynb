   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training K-Means (no CrossValidator)...\nDone.\n"
     ]
    }
   ],
   "source": [
    "KM_FEATURES = [\n",
    "    \"avg_monthly_deaths\", \"max_monthly_deaths\",\n",
    "    \"stddev_deaths\", \"yoy_pct_change\"\n",
    "]\n",
    "\n",
    "km_data = ml_data.dropna(subset=KM_FEATURES)\n",
    "\n",
    "km_assembler = VectorAssembler().setInputCols(KM_FEATURES).setOutputCol(\"raw_features\")\n",
    "\n",
    "km_scaler = (StandardScaler()\n",
    "    .setInputCol(\"raw_features\")\n",
    "    .setOutputCol(\"features\")\n",
    "    .setWithMean(True)\n",
    "    .setWithStd(True)\n",
    ")\n",
    "\n",
    "km = (KMeans()\n",
    "    .setFeaturesCol(\"features\")\n",
    "    .setPredictionCol(\"cluster\")\n",
    "    .setSeed(SEED)\n",
    "    .setK(4)          # choose k\n",
    "    .setMaxIter(50)   # choose maxIter\n",
    ")\n",
    "\n",
    "km_pipeline = Pipeline(stages=[km_assembler, km_scaler, km])\n",
    "\n",
    "km_evaluator = ClusteringEvaluator(\n",
    "    featuresCol=\"features\", predictionCol=\"cluster\", metricName=\"silhouette\"\n",
    ")\n",
    "\n",
    "print(\"Training K-Means (no CrossValidator)...\")\n",
    "km_model = km_pipeline.fit(km_data)\n",
    "print(\"Done.\")\n",
    "\n",
    "clustered = km_model.transform(km_data)"
   ]
  },
