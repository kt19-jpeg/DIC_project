   "source": [
    "train_df, test_df = ml_data.randomSplit([0.8, 0.2], seed=SEED)\n",
    "print(f\"Train: {train_df.count():,}  |  Test: {test_df.count():,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "b7e06eec-7044-4477-80df-d52d78724fc5",
     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training Random Forest Classifier (no CrossValidator)...\nDone.\nTest AUC: 0.9747\n"
     ]
    }
   ],
   "source": [
    "from pyspark.ml import Pipeline\n",
    "from pyspark.ml.feature import StringIndexer, OneHotEncoder, VectorAssembler, StandardScaler\n",
    "from pyspark.ml.classification import RandomForestClassifier\n",
    "from pyspark.ml.evaluation import BinaryClassificationEvaluator\n",
    "\n",
    "# Cast year to integer for VectorAssembler compatibility\n",
    "train_df = train_df.withColumn(\"year\", F.col(\"year\").cast(\"int\"))\n",
    "test_df = test_df.withColumn(\"year\", F.col(\"year\").cast(\"int\"))\n",
    "\n",
    "# Pipeline: StringIndex drug_category → OHE → assemble → scale → RF\n",
    "cat_indexer  = StringIndexer(inputCol=\"drug_category\", outputCol=\"drug_idx\", handleInvalid=\"keep\")\n",
    "cat_ohe      = OneHotEncoder(inputCol=\"drug_idx\", outputCol=\"drug_ohe\")\n",
    "rf_assembler = VectorAssembler(inputCols=NUM_FEATURES + [\"drug_ohe\"], outputCol=\"raw_features\")\n",
    "\n",
    "# withMean=False because OHE produces sparse vectors\n",
    "rf_scaler    = StandardScaler(inputCol=\"raw_features\", outputCol=\"features\",\n",
    "                              withMean=False, withStd=True)\n",
    "\n",
    "rf_clf = (RandomForestClassifier(\n",
    "    featuresCol=\"features\", labelCol=\"label\",\n",
    "    predictionCol=\"prediction\", probabilityCol=\"probability\",\n",
    "    rawPredictionCol=\"rawPrediction\",\n",
    "    seed=SEED\n",
    ")\n",
    "    .setNumTrees(100)\n",
    "    .setMaxDepth(10)\n",
    "    .setMinInstancesPerNode(1)\n",
    ")\n",
    "\n",
    "rf_pipeline = Pipeline(stages=[cat_indexer, cat_ohe, rf_assembler, rf_scaler, rf_clf])\n",
    "\n",
    "print(\"Training Random Forest Classifier (no CrossValidator)...\")\n",
    "rf_model = rf_pipeline.fit(train_df)\n",
    "print(\"Done.\")\n",
    "\n",
    "# Evaluate on test (recommended) or train\n",
    "preds = rf_model.transform(test_df)  # use test_df if you have it\n",
    "rf_evaluator = BinaryClassificationEvaluator(\n",
    "    labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderROC\"\n",
    ")\n",
    "auc = rf_evaluator.evaluate(preds)\n",
    "print(f\"Test AUC: {auc:.4f}\")"
   ]
  },
