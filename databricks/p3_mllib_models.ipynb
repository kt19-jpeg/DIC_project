   "source": [
    "gold_features = spark.table(f\"{DB_NAME}.gold_ml_features\")\n",
    "gold_kff      = spark.table(f\"{DB_NAME}.gold_cdc_kff_joined\")\n",
    "\n",
    "print(f\"gold_ml_features : {gold_features.count():,} rows\")\n",
    "print(f\"gold_cdc_kff     : {gold_kff.count():,} rows\")\n",
    "gold_features.printSchema()"
   ]
