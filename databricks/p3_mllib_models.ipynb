   "source": [
    "# Numeric feature columns shared across models\n",
    "NUM_FEATURES = [\n",
    "    \"avg_monthly_deaths\", \"max_monthly_deaths\",\n",
    "    \"stddev_deaths\", \"months_reported\",\n",
    "    \"yoy_pct_change\", \"avg_pct_pending\", \"year\"\n",
    "]\n",
    "\n",
    "# Base cleaned ML dataset\n",
    "ml_data = (\n",
    "    gold_features\n",
    "    .filter(F.col(\"year\").between(2016, 2023))\n",
    "    .dropna(subset=NUM_FEATURES + [\"annual_deaths\", \"high_burden\", \"drug_category\"])\n",
    "    .withColumn(\"label\", F.col(\"high_burden\").cast(DoubleType()))\n",
    ")\n",
    "\n",
    "print(f\"ML base rows: {ml_data.count():,}\")\n",
    "ml_data.groupBy(\"label\").count().show()"
   ]
