   "source": [
    "from pyspark.ml import Pipeline\n",
    "from pyspark.ml.feature import VectorAssembler, StandardScaler\n",
    "from pyspark.ml.regression import LinearRegression\n",
    "from pyspark.ml.evaluation import RegressionEvaluator\n",
    "\n",
    "# Cast year to integer for VectorAssembler compatibility\n",
    "ridge_train = ridge_train.withColumn(\"year\", F.col(\"year\").cast(\"int\"))\n",
    "ridge_test = ridge_test.withColumn(\"year\", F.col(\"year\").cast(\"int\"))\n",
    "\n",
    "# -----------------------------\n",
    "# Ridge pipeline \n",
    "# -----------------------------\n",
    "ridge_assembler = VectorAssembler(inputCols=RIDGE_FEATURES, outputCol=\"raw_features\")\n",
    "\n",
    "ridge_scaler = StandardScaler(\n",
    "    inputCol=\"raw_features\",\n",
    "    outputCol=\"features\",\n",
    "    withMean=True,\n",
    "    withStd=True\n",
    ")\n",
    "\n",
    "ridge = LinearRegression(\n",
    "    featuresCol=\"features\",\n",
    "    labelCol=RIDGE_TARGET,\n",
    "    predictionCol=\"predicted_deaths\",\n",
    "    elasticNetParam=0.0  # Ridge (L2)\n",
    ")\n",
    "\n",
    "ridge_pipeline = Pipeline(stages=[ridge_assembler, ridge_scaler, ridge])\n",
    "\n",
    "# -----------------------------\n",
    "# Replace CrossValidator with a manual param sweep (no CV)\n",
    "# Same param grid, same evaluator metric (RMSE)\n",
    "# -----------------------------\n",
    "ridge_param_grid = [\n",
    "    {\"regParam\": rp, \"maxIter\": mi}\n",
    "    for rp in [0.01, 0.1, 0.5, 1.0]\n",
    "    for mi in [50, 100]\n",
    "]\n",
    "\n",
    "ridge_evaluator = RegressionEvaluator(\n",
    "    labelCol=RIDGE_TARGET,\n",
    "    predictionCol=\"predicted_deaths\",\n",
    "    metricName=\"rmse\"\n",
    ")\n",
    "\n",
    "print(f\"Training Ridge Regression (manual sweep: {len(ridge_param_grid)} param combos)...\")\n",
    "\n",
    "best_rmse = float(\"inf\")\n",
    "best_model = None\n",
    "best_params = None\n",
    "results = []\n",
    "\n",
    "for p in ridge_param_grid:\n",
    "    # set params on the estimator (LinearRegression) inside the pipeline\n",
    "    ridge.setRegParam(p[\"regParam\"])\n",
    "    ridge.setMaxIter(p[\"maxIter\"])\n",
    "\n",
    "    model = ridge_pipeline.fit(ridge_train)\n",
    "    preds = model.transform(ridge_train)  # keep logic similar; ideally evaluate on a val split\n",
    "\n",
    "    rmse = ridge_evaluator.evaluate(preds)\n",
    "    results.append((p[\"regParam\"], p[\"maxIter\"], rmse))\n",
    "\n",
    "    if rmse < best_rmse:\n",
    "        best_rmse = rmse\n",
    "        best_model = model\n",
    "        best_params = p\n",
    "\n",
    "print(\"Done.\")\n",
    "print(\"RMSE by params:\", results)\n",
    "print(\"Best params:\", best_params)\n",
    "print(f\"Best RMSE  : {best_rmse:.4f}\")\n",
    "\n",
    "# Output model consistent with your old variable name style\n",
    "ridge_model = best_model"
   ]
  },
